# RTX 5060: compute capability 12.0, CMake architecture 120.
CUDA_ARCHITECTURES=120
# For Gemini/OpenAI with local CUDA embeddings, select Dockerfile.cloud.
# Local llama.cpp extraction requires the original Dockerfile.
ML_DOCKERFILE=Dockerfile
# local runs llama.cpp; openai sends extracted resume text to the OpenAI API.
ML_LLM_PROVIDER=local
ML_OPENAI_MODEL=gpt-4o-mini
# Set a private key only in your local .env when selecting openai.
ML_OPENAI_API_KEY=
# Conservative starting context on 8 GB VRAM; measure with your chosen GGUF.
ML_LLM_CONTEXT=4096
ML_LLM_MAX_TOKENS=1024

# Optional Gemini extraction; secret belongs only in local .env.
ML_GEMINI_MODEL=gemini-3.8-flash
ML_GEMINI_API_KEY=
ML_GEMINI_MAX_TOKENS=8192
