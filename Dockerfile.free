# CPU-only free-tier image — no CUDA toolchain, no llama-cpp-python.
# ~700 MB image vs ~8 GB CUDA build image.
# Extraction: Antigravity/Gemini via API key. Embeddings: sentence-transformers on CPU.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false

WORKDIR /service

# CPU torch lives on a separate index; install it first so the constraint is
# set before sentence-transformers pulls in a full CUDA wheel.
RUN pip install torch==2.7.1+cpu --index-url https://download.pytorch.org/whl/cpu --no-cache-dir

COPY requirements.free.txt ./
RUN pip install -r requirements.free.txt --no-cache-dir \
    && pip check

RUN groupadd --gid 10001 mlservice \
    && useradd --uid 10001 --gid mlservice --create-home mlservice

COPY --chown=mlservice:mlservice app ./app

# Embed the embedding model weights so no volume mount is needed at runtime.
# Run scripts/download_models.py locally first so models/embedding exists.
COPY --chown=mlservice:mlservice models/embedding /models/embedding

USER mlservice
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)" || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--limit-concurrency", "8", \
     "--timeout-keep-alive", "5", "--no-access-log"]
